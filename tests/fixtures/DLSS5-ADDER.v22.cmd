@echo off
setlocal EnableExtensions DisableDelayedExpansion

rem ============================================================================
rem Single-file interactive DLSS 5 installer/updater bootstrap.
rem
rem Design:
rem   - Double-clickable .cmd
rem   - Immediately hands off to pwsh -NoProfile
rem   - Embedded PowerShell payload
rem   - External per-game and per-machine notes/state
rem   - Interactive agent session (Codex by default)
rem   - Agent researches current DLSS 5 installation method online
rem   - Agent may ask user for binaries when trustworthy acquisition fails
rem   - Transactional backup/rollback expectations
rem   - Bootstrap self-modification only after explicit user approval
rem ============================================================================

rem ----- Immutable bootstrap metadata ------------------------------------------
rem Increment this integer whenever the bootstrap/payload logic is intentionally
rem changed. The PowerShell payload uses it when deciding whether a bootstrap
rem checksum change is an intentional upgrade or an unexpected modification.
rem
rem DLSS5_BOOTSTRAP_VERSION=22

set "DLSS5_SELF=%~f0"
set "DLSS5_DIR=%~dp0"

where pwsh.exe >nul 2>nul
if errorlevel 1 (
    echo.
    echo ERROR: pwsh.exe ^(PowerShell 7+^) was not found in PATH.
    echo Install PowerShell 7 or make pwsh.exe available in PATH, then retry.
    echo.
    pause
    exit /b 1
)

set "DLSS5_TMP_PS1=%TEMP%\dlss5-updater-%RANDOM%-%RANDOM%.ps1"

pwsh.exe -NoProfile -ExecutionPolicy Bypass -EncodedCommand 

if errorlevel 1 (
    echo.
    echo ERROR: could not extract embedded PowerShell payload.
    echo.
    pause
    exit /b 1
)

pwsh.exe -NoProfile -ExecutionPolicy Bypass -File "%DLSS5_TMP_PS1%" -SelfPath "%DLSS5_SELF%"
set "DLSS5_EXIT=%ERRORLEVEL%"

if not exist "%DLSS5_TMP_PS1%" goto DLSS5_PAYLOAD_CLEANUP_DONE
echo.
echo Temporary updater staging file:
echo   %DLSS5_TMP_PS1%
echo Recoverability: deletion is permanent, but the file can be regenerated by running this updater again.
choice /c YN /n /m "Delete this staging file now? [Y/N] "
if errorlevel 2 goto DLSS5_PAYLOAD_RETAINED
del /q "%DLSS5_TMP_PS1%" >nul 2>nul
if exist "%DLSS5_TMP_PS1%" echo WARNING: could not delete staging file: %DLSS5_TMP_PS1%
goto DLSS5_PAYLOAD_CLEANUP_DONE

:DLSS5_PAYLOAD_RETAINED
echo Retained staging file: %DLSS5_TMP_PS1%

:DLSS5_PAYLOAD_CLEANUP_DONE

if not "%DLSS5_EXIT%"=="0" (
    echo.
    echo DLSS5 updater exited with code %DLSS5_EXIT%.
    echo.
    pause
)

exit /b %DLSS5_EXIT%


### === POWERSHELL_PAYLOAD_BEGIN ===
param(
    [Parameter(Mandatory=$true)]
    [string]$SelfPath
)

Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'

# ------------------------------------------------------------------------------
# Constants / markers
# ------------------------------------------------------------------------------

$BootstrapVersionMarker = 'rem DLSS5_BOOTSTRAP_VERSION='
$PayloadMarkerPrefix     = '### === POWERSHELL_PAYLOAD_'
$PayloadMarkerSuffix     = ' ==='
$PayloadBeginMarker      = $PayloadMarkerPrefix + 'BEGIN' + $PayloadMarkerSuffix
$PayloadEndMarker        = $PayloadMarkerPrefix + 'END' + $PayloadMarkerSuffix
$GameNotesMarkerPrefix   = '### === DLSS5_GAME_NOTES_'
$GameNotesMarkerSuffix   = ' ==='
$GameNotesBeginMarker    = $GameNotesMarkerPrefix + 'BEGIN' + $GameNotesMarkerSuffix
$GameNotesEndMarker      = $GameNotesMarkerPrefix + 'END' + $GameNotesMarkerSuffix
$MachineNotesMarkerPrefix= '### === DLSS5_MACHINE_NOTES_'
$MachineNotesMarkerSuffix= ' ==='
$MachineNotesBeginMarker = $MachineNotesMarkerPrefix + 'BEGIN' + $MachineNotesMarkerSuffix
$MachineNotesEndMarker   = $MachineNotesMarkerPrefix + 'END' + $MachineNotesMarkerSuffix
$ProjectKnowledgeMarkerPrefix = '### === DLSS5_PROJECT_KNOWLEDGE_'
$ProjectKnowledgeMarkerSuffix = ' ==='
$ProjectKnowledgeBeginMarker = $ProjectKnowledgeMarkerPrefix + 'BEGIN' + $ProjectKnowledgeMarkerSuffix
$ProjectKnowledgeEndMarker = $ProjectKnowledgeMarkerPrefix + 'END' + $ProjectKnowledgeMarkerSuffix
$GameNotesOrder = @(
    'schema_version', 'game_fingerprint', 'game_name', 'steam_appid',
    'main_executables', 'last_checked', 'status', 'installed_components',
    'game_quirks', 'target_display.*', 'recommended_game_settings', 'settings_optimization',
    'visual_verification', 'review_status', 'failed_routes',
    'verified_evidence', 'sources_checked', 'transaction_status', 'last_result'
)
$GameNotesSchemaKeys = @($GameNotesOrder | Where-Object { -not $_.EndsWith('.*', [StringComparison]::Ordinal) })
$MachineNotesOrder = @(
    'schema_version', 'last_checked', 'probe_status', 'gpu', 'gpu_generation',
    'driver_version', 'vram_mib', 'cpu', 'ram_mib', 'os',
    'hardware_constraints', 'display_topology_status', 'display_topology_evidence',
    'display.*', 'bootstrap_highest_version_seen', 'bootstrap_checksum.*',
    'migration.v17.*'
)
$ProjectKnowledgeOrder = @(
    'schema_version', 'last_checked', 'status', 'official_nvidia_dlss5',
    'renodx', 'dlss5_feeder', 'dlss5_bridge', 'opengl_bridge',
    'optiscaler_upstream', 'optiscaler_dlssnr_fork', 'renodx_installer',
    'dlss5_autopilot', 'dlss5_swapper', 'rhi', 'dlss5_oneclick',
    'feedkit', 'lumenitefx', 'signature_repair', 'streamline', 'reference_projects',
    'trust_policy', 'compatibility_boundaries', 'sources_checked', 'last_result'
)

# ------------------------------------------------------------------------------
# Helpers
# ------------------------------------------------------------------------------

function Read-Self {
    Get-Content -LiteralPath $SelfPath -Raw
}

function Request-Dlss5DestructiveActionConfirmation {
    param(
        [Parameter(Mandatory=$true)][string]$Action,
        [Parameter(Mandatory=$true)][AllowEmptyCollection()][string[]]$TargetPaths,
        [Parameter(Mandatory=$true)][string]$Recoverability
    )

    Write-Host ''
    Write-Warning $Action
    Write-Host 'Exact targets:'
    foreach ($targetPath in $TargetPaths) {
        Write-Host "  $targetPath"
    }
    Write-Host "Recoverability: $Recoverability"
    $answer = Read-Host 'Proceed? Type YES to continue'

    return [string]::Equals($answer, 'YES', [StringComparison]::Ordinal)
}

function Invoke-Dlss5DestructiveActionConfirmation {
    param(
        [Parameter(Mandatory=$true)][string]$Action,
        [Parameter(Mandatory=$true)][AllowEmptyCollection()][string[]]$TargetPaths,
        [Parameter(Mandatory=$true)][string]$Recoverability,
        [scriptblock]$Confirmation
    )

    if ($null -ne $Confirmation) {
        return [bool](& $Confirmation -Action $Action -TargetPaths $TargetPaths -Recoverability $Recoverability)
    }

    return Request-Dlss5DestructiveActionConfirmation -Action $Action -TargetPaths $TargetPaths -Recoverability $Recoverability
}

function Test-GitMetadataPresent {
    param(
        [Parameter(Mandatory=$true)]
        [string]$Directory
    )

    $current = [IO.DirectoryInfo]::new([IO.Path]::GetFullPath($Directory))
    while ($null -ne $current) {
        if (Test-Path -LiteralPath (Join-Path $current.FullName '.git')) {
            return $true
        }
        $current = $current.Parent
    }

    $false
}

function Get-Dlss5GitBlockingEntries {
    param(
        [Parameter(Mandatory=$true)][AllowEmptyCollection()][string[]]$StatusLines,
        [Parameter(Mandatory=$true)][System.Collections.Generic.HashSet[string]]$AllowedUntrackedPaths
    )

    $blocking = [System.Collections.Generic.List[string]]::new()
    foreach ($entry in $StatusLines) {
        if ([string]::IsNullOrWhiteSpace($entry)) {
            continue
        }

        if ($entry.StartsWith('?? ', [StringComparison]::Ordinal) -and $AllowedUntrackedPaths.Contains($entry.Substring(3))) {
            continue
        }
        $blocking.Add($entry)
    }

    return @($blocking)
}

function Invoke-Dlss5GitStatusPorcelainZ {
    param(
        [Parameter(Mandatory=$true)][string]$GitPath,
        [Parameter(Mandatory=$true)][string]$RepositoryRoot,
        [Parameter(Mandatory=$true)][string]$Pathspec
    )

    $startInfo = [Diagnostics.ProcessStartInfo]::new()
    $startInfo.FileName = $GitPath
    $startInfo.UseShellExecute = $false
    $startInfo.RedirectStandardOutput = $true
    $startInfo.RedirectStandardError = $true
    foreach ($argument in @('-C', $RepositoryRoot, 'status', '--porcelain=v1', '-z', '--untracked-files=all', '--', $Pathspec)) {
        $startInfo.ArgumentList.Add($argument)
    }
    $process = [Diagnostics.Process]::new()
    $process.StartInfo = $startInfo
    try {
        if (-not $process.Start()) {
            throw [IO.InvalidDataException]::new('Git status process did not start.')
        }
        $stdout = $process.StandardOutput.ReadToEnd()
        $stderr = $process.StandardError.ReadToEnd()
        $process.WaitForExit()
        if ($process.ExitCode -ne 0) {
            throw [IO.InvalidDataException]::new("Could not inspect Git status for game directory: $stderr")
        }
        return $stdout
    }
    finally {
        $process.Dispose()
    }
}

function Invoke-Dlss5GitTrackedPathQuery {
    param(
        [Parameter(Mandatory=$true)][string]$GitPath,
        [Parameter(Mandatory=$true)][string]$RepositoryRoot,
        [Parameter(Mandatory=$true)][string]$Pathspec
    )

    $startInfo = [Diagnostics.ProcessStartInfo]::new()
    $startInfo.FileName = $GitPath
    $startInfo.UseShellExecute = $false
    $startInfo.RedirectStandardOutput = $true
    $startInfo.RedirectStandardError = $true
    foreach ($argument in @('-C', $RepositoryRoot, 'ls-files', '-z', '--', $Pathspec)) {
        $startInfo.ArgumentList.Add($argument)
    }
    $process = [Diagnostics.Process]::new()
    $process.StartInfo = $startInfo
    try {
        if (-not $process.Start()) {
            throw [IO.InvalidDataException]::new('Git tracking query process did not start.')
        }
        $stdout = $process.StandardOutput.ReadToEnd()
        $stderr = $process.StandardError.ReadToEnd()
        $process.WaitForExit()
        if ($process.ExitCode -ne 0) {
            throw [IO.InvalidDataException]::new("Could not inspect Git tracking for updater: $stderr")
        }
        foreach ($record in $stdout.Split([char]0, [StringSplitOptions]::RemoveEmptyEntries)) {
            if ([string]::Equals($record, $Pathspec, [StringComparison]::Ordinal)) {
                return $true
            }
        }

        return $false
    }
    finally {
        $process.Dispose()
    }
}

function Get-Dlss5GitBlockingEntriesFromPorcelainZ {
    param(
        [Parameter(Mandatory=$true)][AllowEmptyString()][string]$Porcelain,
        [Parameter(Mandatory=$true)][System.Collections.Generic.HashSet[string]]$AllowedUntrackedPaths
    )

    $records = @($Porcelain.Split([char]0, [StringSplitOptions]::RemoveEmptyEntries))
    $blocking = [System.Collections.Generic.List[string]]::new()
    for ($index = 0; $index -lt $records.Count; $index++) {
        $record = $records[$index]
        if ($record.Length -lt 3) {
            throw [IO.InvalidDataException]::new('Git status returned a malformed porcelain record.')
        }
        $status = $record.Substring(0, 2)
        $path = $record.Substring(3)
        if ($status -eq '??' -and $AllowedUntrackedPaths.Contains($path)) {
            continue
        }
        $blocking.Add("$status $path")
        if (($status.Contains('R') -or $status.Contains('C')) -and $index + 1 -lt $records.Count) {
            $index++
        }
    }

    return @($blocking)
}

function Get-Dlss5GitProtection {
    param(
        [Parameter(Mandatory=$true)][string]$GameDirectory,
        [Parameter(Mandatory=$true)][string]$UpdaterPath,
        [Parameter(Mandatory=$true)][string]$GameNotesPath,
        [Parameter(Mandatory=$true)][string]$BackupPath
    )

    $gamePath = [IO.Path]::GetFullPath($GameDirectory)
    $git = Get-Command git -ErrorAction SilentlyContinue
    if ($null -eq $git) {
        if (Test-GitMetadataPresent -Directory $gamePath) {
            throw [IO.InvalidDataException]::new('Git metadata exists, but the git command is unavailable.')
        }
        return [pscustomobject]@{
            IsRepository     = $false
            IsUpdaterTracked = $false
            ShouldBackup     = $true
            ShouldAbort      = $false
            BlockingEntries  = @()
            RepositoryRoot   = $null
        }
    }

    $rootOutput = @(& $git.Source -C $gamePath rev-parse --show-toplevel 2>$null)
    if ($LASTEXITCODE -ne 0 -or $rootOutput.Count -eq 0) {
        if (Test-GitMetadataPresent -Directory $gamePath) {
            throw [IO.InvalidDataException]::new("Git metadata exists, but repository inspection failed: $gamePath")
        }
        return [pscustomobject]@{
            IsRepository     = $false
            IsUpdaterTracked = $false
            ShouldBackup     = $true
            ShouldAbort      = $false
            BlockingEntries  = @()
            RepositoryRoot   = $null
        }
    }

    $root = [IO.Path]::GetFullPath(([string]$rootOutput[0]).Trim())
    $relativeGame = [IO.Path]::GetRelativePath($root, $gamePath).Replace([IO.Path]::DirectorySeparatorChar, [char]'/')
    if ($relativeGame -eq '..' -or $relativeGame.StartsWith('../', [StringComparison]::Ordinal)) {
        throw [IO.InvalidDataException]::new("Game directory is outside the detected Git work tree: $gamePath")
    }

    $relativeUpdater = [IO.Path]::GetRelativePath($root, [IO.Path]::GetFullPath($UpdaterPath)).Replace([IO.Path]::DirectorySeparatorChar, [char]'/')
    $allowed = [System.Collections.Generic.HashSet[string]]::new([StringComparer]::Ordinal)
    foreach ($specialPath in @($UpdaterPath, $GameNotesPath, $BackupPath)) {
        $relativeSpecial = [IO.Path]::GetRelativePath($root, [IO.Path]::GetFullPath($specialPath)).Replace([IO.Path]::DirectorySeparatorChar, [char]'/')
        if ($relativeSpecial -eq '..' -or $relativeSpecial.StartsWith('../', [StringComparison]::Ordinal)) {
            throw [IO.InvalidDataException]::new("Updater-owned path is outside the detected Git work tree: $specialPath")
        }
        [void]$allowed.Add($relativeSpecial)
    }

    $status = Invoke-Dlss5GitStatusPorcelainZ -GitPath $git.Source -RepositoryRoot $root -Pathspec $relativeGame
    $blocking = @(Get-Dlss5GitBlockingEntriesFromPorcelainZ -Porcelain $status -AllowedUntrackedPaths $allowed)

    $isUpdaterTracked = Invoke-Dlss5GitTrackedPathQuery -GitPath $git.Source -RepositoryRoot $root -Pathspec $relativeUpdater

    return [pscustomobject]@{
        IsRepository     = $true
        IsUpdaterTracked = $isUpdaterTracked
        ShouldBackup     = -not $isUpdaterTracked
        ShouldAbort      = $blocking.Count -gt 0
        BlockingEntries  = $blocking
        RepositoryRoot   = $root
    }
}

function Write-SelfAtomically {
    param(
        [Parameter(Mandatory=$true)]
        [string]$Content
    )

    $dir = Split-Path -Parent $SelfPath
    $candidatePath = Join-Path $dir ('.' + [IO.Path]::GetFileName($SelfPath) + '.candidate-' + [Guid]::NewGuid().ToString('N'))
    $backupPath = $SelfPath + '.bkp'
    try {
        [IO.File]::WriteAllText($candidatePath, $Content, [Text.UTF8Encoding]::new($false))
        $check = Get-Content -LiteralPath $candidatePath -Raw
        foreach ($marker in @($BootstrapVersionMarker, $PayloadBeginMarker, $PayloadEndMarker)) {
            if (-not $check.Contains($marker)) {
                throw [IO.InvalidDataException]::new("Required bootstrap marker is missing from candidate: $marker")
            }
        }
        if (-not $script:SelfTrackedInGitIndex) {
            Copy-Item -LiteralPath $SelfPath -Destination $backupPath -Force
        }
        [IO.File]::Move($candidatePath, $SelfPath, $true)
    }
    catch {
        $failure = [IO.IOException]::new("Atomic bootstrap replacement failed: $SelfPath", $_.Exception)
        $failure.Data['CandidatePath'] = $candidatePath
        throw $failure
    }
}

function Get-Dlss5Sha256Bytes {
    param([Parameter(Mandatory=$true)][AllowEmptyCollection()][byte[]]$Bytes)

    $sha = [Security.Cryptography.SHA256]::Create()
    try {
        return ([BitConverter]::ToString($sha.ComputeHash($Bytes))).Replace('-', '').ToLowerInvariant()
    }
    finally {
        $sha.Dispose()
    }
}

function Get-Sha256Text {
    param([Parameter(Mandatory=$true)][string]$Text)

    return Get-Dlss5Sha256Bytes -Bytes ([Text.UTF8Encoding]::new($false).GetBytes($Text))
}

function Get-Dlss5FileSha256 {
    param([Parameter(Mandatory=$true)][string]$Path)

    return Get-Dlss5Sha256Bytes -Bytes ([IO.File]::ReadAllBytes($Path))
}

function Get-BootstrapVersion {
    param([Parameter(Mandatory=$true)][string]$Text)

    $m = [regex]::Match(
        $Text,
        '(?m)^\s*rem\s+DLSS5_BOOTSTRAP_VERSION=(\d+)\s*$',
        [Text.RegularExpressions.RegexOptions]::CultureInvariant
    )

    if (-not $m.Success) {
        throw 'Bootstrap version marker is missing or malformed.'
    }

    [int]$m.Groups[1].Value
}

function ConvertFrom-Dlss5NotesDocument {
    param(
        [Parameter(Mandatory=$true)][string]$Text,
        [Parameter(Mandatory=$true)][string]$BeginMarker,
        [Parameter(Mandatory=$true)][string]$EndMarker
    )

    if (-not $Text.EndsWith("`r`n", [StringComparison]::Ordinal) -or
        [regex]::IsMatch($Text, '(?<!\r)\n|\r(?!\n)', [Text.RegularExpressions.RegexOptions]::CultureInvariant)) {
        throw [IO.InvalidDataException]::new('Notes must use uniform CRLF and end with one newline.')
    }

    $content = $Text.Substring(0, $Text.Length - 2)
    $lines = $content.Split([string[]]@("`r`n"), [StringSplitOptions]::None)
    if ($lines.Count -lt 2 -or
        -not [string]::Equals($lines[0], $BeginMarker, [StringComparison]::Ordinal) -or
        -not [string]::Equals($lines[$lines.Count - 1], $EndMarker, [StringComparison]::Ordinal) -or
        @($lines | Where-Object { [string]::Equals($_, $BeginMarker, [StringComparison]::Ordinal) }).Count -ne 1 -or
        @($lines | Where-Object { [string]::Equals($_, $EndMarker, [StringComparison]::Ordinal) }).Count -ne 1) {
        throw [IO.InvalidDataException]::new('Notes markers are missing, duplicated, or reversed.')
    }

    $notes = [System.Collections.Specialized.OrderedDictionary]::new([StringComparer]::Ordinal)
    for ($index = 1; $index -lt $lines.Count - 1; $index++) {
        $match = [regex]::Match($lines[$index], '^### ([A-Za-z0-9_.-]+): (.*)$', [Text.RegularExpressions.RegexOptions]::CultureInvariant)
        if (-not $match.Success) {
            throw [IO.InvalidDataException]::new("Illegal notes record: $($lines[$index])")
        }

        $key = $match.Groups[1].Value
        if ($notes.Contains($key)) {
            throw [IO.InvalidDataException]::new("Duplicate notes key: $key")
        }
        $notes.Add($key, $match.Groups[2].Value)
    }

    return $notes
}

function ConvertTo-Dlss5NotesDocument {
    param(
        [Parameter(Mandatory=$true)][System.Collections.IDictionary]$Notes,
        [Parameter(Mandatory=$true)][string]$BeginMarker,
        [Parameter(Mandatory=$true)][string]$EndMarker,
        [Parameter(Mandatory=$true)][string[]]$KnownOrder
    )

    $sourceKeys = [System.Collections.Generic.HashSet[string]]::new([StringComparer]::Ordinal)
    foreach ($sourceKey in $Notes.Keys) {
        $keyText = [string]$sourceKey
        if (-not $sourceKeys.Add($keyText)) {
            throw [IO.InvalidDataException]::new("Duplicate notes key: $keyText")
        }
    }

    $knownKeys = [System.Collections.Generic.HashSet[string]]::new([StringComparer]::Ordinal)
    $emittedKeys = [System.Collections.Generic.HashSet[string]]::new([StringComparer]::Ordinal)
    $orderedKeys = [System.Collections.Generic.List[string]]::new()
    foreach ($knownKey in $KnownOrder) {
        if (-not $knownKeys.Add($knownKey)) {
            throw [IO.InvalidDataException]::new("Duplicate known notes key: $knownKey")
        }
        if ($knownKey.EndsWith('.*', [StringComparison]::Ordinal)) {
            $prefix = $knownKey.Substring(0, $knownKey.Length - 1)
            foreach ($sourceKey in $Notes.Keys) {
                $keyText = [string]$sourceKey
                if ($keyText.StartsWith($prefix, [StringComparison]::Ordinal) -and $emittedKeys.Add($keyText)) {
                    $orderedKeys.Add($keyText)
                }
            }
        }
        elseif ($sourceKeys.Contains($knownKey) -and $emittedKeys.Add($knownKey)) {
            $orderedKeys.Add($knownKey)
        }
    }
    foreach ($sourceKey in $Notes.Keys) {
        $keyText = [string]$sourceKey
        if ($emittedKeys.Add($keyText)) {
            $orderedKeys.Add($keyText)
        }
    }

    $lines = [System.Collections.Generic.List[string]]::new()
    $lines.Add($BeginMarker)
    foreach ($key in $orderedKeys) {
        $value = [string]$Notes[$key]
        if ($key -notmatch '^[A-Za-z0-9_.-]+$' -or $value.Contains("`r") -or $value.Contains("`n")) {
            throw [IO.InvalidDataException]::new("Illegal notes key or multiline value: $key")
        }
        $lines.Add("### ${key}: $value")
    }
    $lines.Add($EndMarker)

    return ($lines -join "`r`n") + "`r`n"
}

function Read-Dlss5NotesFile {
    param(
        [Parameter(Mandatory=$true)][string]$Path,
        [Parameter(Mandatory=$true)][string]$BeginMarker,
        [Parameter(Mandatory=$true)][string]$EndMarker
    )

    $bytes = [IO.File]::ReadAllBytes($Path)
    if ($bytes.Length -ge 3 -and $bytes[0] -eq 0xEF -and $bytes[1] -eq 0xBB -and $bytes[2] -eq 0xBF) {
        throw [IO.InvalidDataException]::new('Notes file must not contain a UTF-8 BOM.')
    }
    try {
        $text = [Text.UTF8Encoding]::new($false, $true).GetString($bytes)
    }
    catch [Text.DecoderFallbackException] {
        throw [IO.InvalidDataException]::new('Notes file is not valid UTF-8.', $_.Exception)
    }

    return ConvertFrom-Dlss5NotesDocument -Text $text -BeginMarker $BeginMarker -EndMarker $EndMarker
}

function Test-Dlss5ByteEquality {
    param(
        [Parameter(Mandatory=$true)][byte[]]$Left,
        [Parameter(Mandatory=$true)][byte[]]$Right
    )

    if ($Left.Length -ne $Right.Length) {
        return $false
    }
    for ($index = 0; $index -lt $Left.Length; $index++) {
        if ($Left[$index] -ne $Right[$index]) {
            return $false
        }
    }

    return $true
}

function Invoke-Dlss5AtomicReplacement {
    param(
        [Parameter(Mandatory=$true)][string]$CandidatePath,
        [Parameter(Mandatory=$true)][string]$DestinationPath,
        [Parameter(Mandatory=$true)][byte[]]$ExpectedBytes,
        [Parameter(Mandatory=$true)][scriptblock]$VerifyDestination
    )

    $candidateFullPath = [IO.Path]::GetFullPath($CandidatePath)
    $destinationFullPath = [IO.Path]::GetFullPath($DestinationPath)
    if (-not [string]::Equals((Split-Path -Parent $candidateFullPath), (Split-Path -Parent $destinationFullPath), [StringComparison]::OrdinalIgnoreCase)) {
        throw [IO.InvalidDataException]::new('Atomic candidate and destination must share one directory.')
    }

    $rollbackPath = Join-Path (Split-Path -Parent $destinationFullPath) ('.' + [IO.Path]::GetFileName($destinationFullPath) + '.rollback-' + [Guid]::NewGuid().ToString('N'))
    $destinationExisted = Test-Path -LiteralPath $destinationFullPath -PathType Leaf
    $replacementCompleted = $false
    try {
        if ($destinationExisted) {
            [IO.File]::Replace($candidateFullPath, $destinationFullPath, $rollbackPath, $true)
        }
        else {
            [IO.File]::Move($candidateFullPath, $destinationFullPath)
        }
        $replacementCompleted = $true

        if (-not (& $VerifyDestination $destinationFullPath $ExpectedBytes)) {
            throw [IO.IOException]::new('Destination verification failed after atomic replacement.')
        }

        if (Test-Path -LiteralPath $rollbackPath -PathType Leaf) {
            Write-Host "Retained rollback for confirmed cleanup: $rollbackPath"
        }
    }
    catch {
        $originalFailure = $_.Exception
        $recoveryFailures = [Collections.Generic.List[string]]::new()
        if ($replacementCompleted) {
            if (Test-Path -LiteralPath $destinationFullPath -PathType Leaf) {
                try {
                    [IO.File]::Move($destinationFullPath, $candidateFullPath, $true)
                }
                catch {
                    $recoveryFailures.Add("Failed to retain replaced destination at candidate path: $($_.Exception.Message)")
                }
            }
            if ($destinationExisted -and (Test-Path -LiteralPath $rollbackPath -PathType Leaf)) {
                try {
                    [IO.File]::Move($rollbackPath, $destinationFullPath, $true)
                }
                catch {
                    $recoveryFailures.Add("Failed to restore rollback to destination: $($_.Exception.Message)")
                }
            }
        }

        $failureMessage = "Atomic replacement failed: $destinationFullPath. Candidate path: $candidateFullPath"
        if ($recoveryFailures.Count -gt 0) {
            $failureMessage += '. Recovery failures: ' + [string]::Join(' | ', $recoveryFailures)
        }

        $failure = [IO.IOException]::new($failureMessage, $originalFailure)
        $failure.Data['CandidatePath'] = $candidateFullPath
        if ($recoveryFailures.Count -gt 0) {
            $failure.Data['RecoveryFailures'] = $recoveryFailures.ToArray()
        }
        throw $failure
    }
}

function Write-Dlss5NotesFileAtomically {
    param(
        [Parameter(Mandatory=$true)][string]$Path,
        [Parameter(Mandatory=$true)][System.Collections.IDictionary]$Notes,
        [Parameter(Mandatory=$true)][string]$BeginMarker,
        [Parameter(Mandatory=$true)][string]$EndMarker,
        [Parameter(Mandatory=$true)][string[]]$KnownOrder
    )

    $fullPath = [IO.Path]::GetFullPath($Path)
    $directory = Split-Path -Parent $fullPath
    $candidatePath = Join-Path $directory ('.' + [IO.Path]::GetFileName($fullPath) + '.candidate-' + [Guid]::NewGuid().ToString('N'))
    $content = ConvertTo-Dlss5NotesDocument -Notes $Notes -BeginMarker $BeginMarker -EndMarker $EndMarker -KnownOrder $KnownOrder
    $expectedBytes = [Text.UTF8Encoding]::new($false).GetBytes($content)

    try {
        $stream = [IO.FileStream]::new($candidatePath, [IO.FileMode]::CreateNew, [IO.FileAccess]::Write, [IO.FileShare]::None)
        try {
            $stream.Write($expectedBytes, 0, $expectedBytes.Length)
            $stream.Flush($true)
        }
        finally {
            $stream.Dispose()
        }

        [void](Read-Dlss5NotesFile -Path $candidatePath -BeginMarker $BeginMarker -EndMarker $EndMarker)
        if (-not (Test-Dlss5ByteEquality -Left ([IO.File]::ReadAllBytes($candidatePath)) -Right $expectedBytes)) {
            throw [IO.IOException]::new('Notes candidate readback did not match intended bytes.')
        }

        Invoke-Dlss5AtomicReplacement -CandidatePath $candidatePath -DestinationPath $fullPath -ExpectedBytes $expectedBytes -VerifyDestination {
            param($Path, $Expected)
            return Test-Dlss5ByteEquality -Left ([IO.File]::ReadAllBytes($Path)) -Right $Expected
        }
    }
    catch {
        $innerFailure = $_.Exception
        $reportedCandidatePath = [string]$innerFailure.Data['CandidatePath']
        if ([string]::IsNullOrWhiteSpace($reportedCandidatePath)) {
            $reportedCandidatePath = $candidatePath
        }

        $failureMessage = "Atomic notes replacement failed: $fullPath. Candidate path: $reportedCandidatePath. Inner failure: $($innerFailure.Message)"
        $failure = [IO.IOException]::new($failureMessage, $innerFailure)
        $failure.Data['CandidatePath'] = $reportedCandidatePath
        $recoveryFailures = $innerFailure.Data['RecoveryFailures']
        if ($null -ne $recoveryFailures) {
            $failure.Data['RecoveryFailures'] = $recoveryFailures
        }
        throw $failure
    }
}

function Get-Dlss5MachineNotesPath {
    if ([string]::IsNullOrWhiteSpace($env:LOCALAPPDATA)) {
        throw [IO.DirectoryNotFoundException]::new('LOCALAPPDATA is unavailable; machine notes cannot be resolved.')
